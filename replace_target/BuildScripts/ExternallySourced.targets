<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="3.5" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildCommunityTasksPath>$(MSBuildProjectDirectory)\..\BuildScripts</MSBuildCommunityTasksPath>
  </PropertyGroup>
  <Import Project="$(MSBuildProjectDirectory)\..\BuildScripts\MSBuild.Community.Tasks.Targets" />
  <Target Name="TelerikHTMLProvider">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\TelerikEditorProvider_05.06.03_Install.zip" DestinationFolder="../Website/Install/Provider" />
    <Unzip ZipFileName="$(MSBuildProjectDirectory)\TelerikEditorProvider_05.06.03_Install.zip" TargetDirectory="$(MSBuildProjectDirectory)\unzip" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\unzip\bin\DotNetNuke.HtmlEditor.TelerikEditorProvider.dll" DestinationFolder="../Website/bin" />
    <RemoveDir Directories ="$(MSBuildProjectDirectory)\unzip" />
  </Target>
  <Target Name="PackageProvider" DependsOnTargets="TelerikHTMLProvider" Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
  </Target>
</Project>
